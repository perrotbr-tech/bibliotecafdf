rules_version = '2';

// Reglas de seguridad de la biblioteca — Etapas 1, 2 y entrega Préstamos
// (specs/03 + specs/04).
//
// Negación por defecto: lo que no está escrito aquí está denegado.
//
// Presupuesto de accesos a otros documentos (contrato §7): máximo 10 por
// operación y 20 por transacción, contados sin suponer ahorro por caché. Por
// eso cada `get()` se hace UNA vez y su resultado se pasa como argumento a las
// funciones que lo examinan, en vez de repetir la llamada.
//
// Cuentas conservadoras, contando cada `get()` y cada `getAfter()` como un
// acceso aunque repita documento. El techo real está medido aparte, en
// `tests/reglas/presupuesto.test.mjs`: el emulador cobra documentos DISTINTOS
// y no cobra los que la propia transacción escribe. Lo que se promete aquí:
//
//   lectura de cualquier colección → 1 (el propio voluntario)
//   sincronización de hora         → 1 (el propio voluntario)
//   alta o cambio de voluntario    → 2 (el propio voluntario + config/control)
//   cambio de config/app           → 2 (el propio voluntario + config/control)
//   alta o edición de libro        → 2 (el propio voluntario + config/control)
//   cambio de teléfono de lector   → 2 (el propio voluntario + config/control)
//   alta de lector (3 documentos)  → 10 en la transacción, máximo 4 por
//                                     operación:
//     · `lectores/{id}`        4 = voluntario + control + getAfter(clave)
//                                                       + getAfter(contadores)
//     · `lectoresClave/{clave}` 3 = voluntario + control + getAfter(lector)
//     · `config/contadores`     3 = voluntario + control + getAfter(lector)
//   cambio de nombre de lector     → 6 como máximo (3 del lector + 3 de la
//                                     clave nueva, si hay que crearla)
//   prestar (3 documentos)         → 14 en la transacción, máximo 6 por
//                                     operación:
//     · `prestamos/{id}`       6 = voluntario + control + calendario
//                                                       + getAfter(libro)
//                                                       + getAfter(contadores)
//                                                       + get(lector)
//     · `libros/{codigo}`      4 = voluntario + control + getAfter(préstamo)
//                                                       + getAfter(contadores)
//     · `config/contadores`    4 = voluntario + control + getAfter(préstamo)
//                                                       + getAfter(libro)
//   devolver / anular / reabrir    → 4 (voluntario + control + getAfter libro
//                                     + getAfter préstamo en el lado del libro)
//   recordar por WhatsApp          → 2 (voluntario + control)
//   corregir «a tiempo»            → 2 (voluntario/admin + control)
//
// Lo que estas reglas NO garantizan (declarado a propósito):
//   · No reproducen la normalización Unicode del cliente: de la `clave`
//     comprueban su FORMA, no que corresponda al `nombre` (base §5). Eso lo
//     garantizan `claveDeNombre` y sus pruebas de unidad.
//   · No comprueban que `categoria` sea una de `config/app.categorias`: el
//     lenguaje de reglas no puede recorrer una lista de mapas. Lo validan el
//     cliente y el script de carga.
//   · No recalculan agregados.
//   · No demuestran que `salidaDia` sea sábado por aritmética civil: lo
//     demuestran al exigir el documento `calendario/{salidaDia}`, que solo
//     el script del dueño escribe y solo para sábados.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- sesión

    function hayCorreoVerificado() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function correo() {
      return request.auth.token.email.lower();
    }

    function docVoluntario(bib) {
      return get(/databases/$(database)/documents/bibliotecas/$(bib)/voluntarios/$(correo()));
    }

    function activo(doc) {
      return doc != null && doc.data.get('activo', false) == true;
    }

    function admin(doc) {
      return activo(doc) && doc.data.get('rol', '') == 'admin';
    }

    // Una persona es voluntaria si inició sesión, su correo está verificado y
    // existe su documento con activo verdadero. Iniciar sesión no basta.
    function esVoluntario(bib) {
      return hayCorreoVerificado() && activo(docVoluntario(bib));
    }

    function esAdmin(bib) {
      return hayCorreoVerificado() && admin(docVoluntario(bib));
    }

    // -------------------------------------------------------------- bloqueos

    function docControl(bib) {
      return get(/databases/$(database)/documents/bibliotecas/$(bib)/config/control);
    }

    // Un bloqueo de mantenimiento no expira solo: su `hasta` es nulo. Un cierre
    // lleva `hasta` obligatorio y deja de regir cuando lo pasa request.time.
    function bloqueoVigente(doc) {
      return doc.data.get('bloqueo', null) != null
        && (doc.data.bloqueo.get('hasta', null) == null
            || request.time < doc.data.bloqueo.hasta);
    }

    // Sin documento de control no se escribe (contrato §6).
    function sinBloqueo(bib) {
      return permiteEscritura(docControl(bib));
    }

    function permiteEscritura(doc) {
      return doc != null && !bloqueoVigente(doc);
    }

    // -------------------------------------------------------------- utilería

    function formatoId(valor) {
      return valor is string && valor.matches('^[0-9a-f]{32}$');
    }

    function horaDelServidor(valor) {
      return valor == request.time;
    }

    function cambia(permitidos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(permitidos);
    }

    // --------------------------------------------- formas de la Etapa 2

    /**
     * Identificador de un lector: `L` más el correlativo con al menos tres
     * cifras. El 7 da `L007`; el 1204, `L1204`. Se construye desde el número
     * en vez de interpretarlo, para que el contador y el identificador no
     * puedan discrepar.
     */
    function idDeLector(n) {
      return 'L' + (n < 10 ? '00' : (n < 100 ? '0' : '')) + string(n);
    }

    function formatoIdLector(valor) {
      return valor is string && valor.matches('^L[0-9]{3,}$');
    }

    function nombreDeLector(nombre) {
      return nombre is string && nombre.size() >= 3 && nombre.size() <= 60;
    }

    /**
     * Forma de una clave: fichas de letras, dígitos y `ñ` separadas por un
     * solo espacio, sin espacios en los extremos, y con al menos tres letras.
     * La segunda expresión es la que exige esas tres letras.
     */
    function formatoClave(clave) {
      return clave is string
        && clave.size() <= 60
        && clave.matches('^[a-z0-9ñ]+( [a-z0-9ñ]+)*$')
        && clave.matches('^[0-9 ]*[a-zñ][0-9 ]*[a-zñ][0-9 ]*[a-zñ][a-z0-9ñ ]*$');
    }

    function telefonoDeLector(valor) {
      return valor == null || (valor is string && valor.matches('^569[0-9]{8}$'));
    }

    /**
     * Aviso de uso de datos: la casilla obligatoria de la pantalla de alta.
     * Las reglas la exigen para que no se salte ocultando el botón: lleva la
     * hora del servidor y el correo de quien inscribe.
     */
    function avisoDeDatos(aviso) {
      return aviso is map
        && aviso.keys().hasOnly(['fecha', 'por'])
        && aviso.keys().hasAll(['fecha', 'por'])
        && aviso.fecha == request.time
        && aviso.por == correo();
    }

    function tituloDeLibro(valor) {
      return valor is string && valor.size() >= 2 && valor.size() <= 120;
    }

    function autorDeLibro(valor) {
      return valor is string && valor.size() <= 80;
    }

    function categoriaDeLibro(valor) {
      return valor is string && valor.size() >= 1 && valor.size() <= 40;
    }

    // ------------------------------------- enlaces entre documentos nuevos

    function contadoresDespues(bib) {
      return getAfter(/databases/$(database)/documents/bibliotecas/$(bib)/config/contadores);
    }

    function lectorDespues(bib, idLector) {
      return getAfter(/databases/$(database)/documents/bibliotecas/$(bib)/lectores/$(idLector));
    }

    function claveDespues(bib, clave) {
      return getAfter(/databases/$(database)/documents/bibliotecas/$(bib)/lectoresClave/$(clave));
    }

    function prestamoDespues(bib, id) {
      return getAfter(/databases/$(database)/documents/bibliotecas/$(bib)/prestamos/$(id));
    }

    function libroDespues(bib, codigo) {
      return getAfter(/databases/$(database)/documents/bibliotecas/$(bib)/libros/$(codigo));
    }

    function docCalendario(bib, salidaDia) {
      return get(/databases/$(database)/documents/bibliotecas/$(bib)/calendario/$(salidaDia));
    }

    function docLector(bib, idLector) {
      return get(/databases/$(database)/documents/bibliotecas/$(bib)/lectores/$(idLector));
    }

    /** El contador quedó en el número de este identificador y lo enlaza. */
    function contadorEnlaza(doc, idLector) {
      return doc != null
        && doc.data.get('ultimoLectorId', null) == idLector
        && doc.data.get('ultimoLector', 0) is int
        && idDeLector(doc.data.ultimoLector) == idLector;
    }

    /** Contador de préstamos: N→N+1 enlazando este documento nuevo. */
    function contadorEnlazaPrestamo(doc, idPrestamo, numero) {
      return doc != null
        && doc.data.get('ultimoPrestamoId', null) == idPrestamo
        && doc.data.get('ultimoPrestamo', 0) is int
        && doc.data.ultimoPrestamo == numero;
    }

    /** El documento de clave quedó apuntando a este lector. */
    function claveApunta(doc, idLector) {
      return doc != null && doc.data.get('lector', '') == idLector;
    }

    /** El lector quedó con esta clave. */
    function lectorTieneClave(doc, clave) {
      return doc != null && doc.data.get('clave', '') == clave;
    }

    /**
     * El lector enlazado es NUEVO: su `creadoEn` es la hora de esta misma
     * petición, de modo que no se puede subir el contador apuntando a un
     * lector que ya existía. Se comprueba así, y no con `exists()`, para no
     * gastar otro acceso.
     */
    function lectorRecienCreado(doc) {
      return doc != null && doc.data.get('creadoEn', null) == request.time;
    }

    /** El préstamo enlazado es NUEVO: `creadoEn` es la hora de esta petición. */
    function prestamoRecienCreado(doc) {
      return doc != null && doc.data.get('creadoEn', null) == request.time;
    }

    function prestamoNuevoEnlazado(doc, idPrestamo, numero) {
      return prestamoRecienCreado(doc)
        && doc.data.get('numero', 0) == numero
        && doc.data.get('estado', '') == 'abierto'
        && formatoId(idPrestamo);
    }

    function metadatosDeOperacion() {
      return request.resource.data.keys().hasAll(['ultimaOperacionId', 'modificadoEn'])
        && formatoId(request.resource.data.ultimaOperacionId)
        && horaDelServidor(request.resource.data.modificadoEn);
    }

    function dentroDeDiezMinutos(desde) {
      return desde is timestamp && request.time < desde + duration.value(10, 'm');
    }

    /**
     * Calendario de confianza: temporada y vencimiento exactos; ventana del
     * sábado para el flujo normal; diferido solo administrador con motivo.
     */
    function calendarioCoincide(cal, datos) {
      return cal != null
        && cal.data.keys().hasAll(['inicio', 'finExclusivo', 'temporada', 'vencimientos'])
        && datos.plazoSabados is int
        && datos.plazoSabados >= 1
        && datos.plazoSabados <= 4
        && cal.data.vencimientos.size() == 4
        && datos.venceEl == cal.data.vencimientos[datos.plazoSabados - 1]
        && datos.temporada == cal.data.temporada
        && (
          (datos.registroDiferido == false
            && datos.motivoRegistroDiferido == null
            && cal.data.inicio <= request.time
            && request.time < cal.data.finExclusivo)
          || (datos.registroDiferido == true
            && datos.motivoRegistroDiferido is string
            && datos.motivoRegistroDiferido.size() >= 10
            && datos.motivoRegistroDiferido.size() <= 200
            && cal.data.inicio <= request.time)
        );
    }

    function lectorPrestable(doc) {
      return doc != null && doc.data.get('fusionadoEn', null) == null;
    }

    function libroQuedoPrestado(docLibro, idPrestamo, vecesAntes) {
      return docLibro != null
        && docLibro.data.get('baja', true) == false
        && docLibro.data.get('prestamoAbierto', null) == idPrestamo
        && docLibro.data.get('vecesPrestado', -1) == vecesAntes + 1;
    }

    function libroQuedoLibreTrasDevolver(docLibro, vecesAntes) {
      return docLibro != null
        && docLibro.data.get('prestamoAbierto', 'x') == null
        && docLibro.data.get('vecesPrestado', -1) == vecesAntes;
    }

    // En anular, vecesPrestado baja exactamente uno y no queda negativo.
    function libroQuedoLibreTrasAnular(docLibro, vecesAntes) {
      return docLibro != null
        && docLibro.data.get('prestamoAbierto', 'x') == null
        && docLibro.data.get('vecesPrestado', -1) == vecesAntes - 1
        && vecesAntes >= 1;
    }

    function libroQuedoReabierto(docLibro, idPrestamo, vecesAntes) {
      return docLibro != null
        && docLibro.data.get('prestamoAbierto', null) == idPrestamo
        && docLibro.data.get('vecesPrestado', -1) == vecesAntes;
    }

    // ------------------------------------------------------------ biblioteca

    match /bibliotecas/{bib} {

      // --- voluntarios -----------------------------------------------------

      match /voluntarios/{documentoCorreo} {

        // Lo lee cualquier voluntario activo.
        allow read: if esVoluntario(bib);

        // Lo crea solo un administrador. El identificador es el correo en
        // minúsculas, y el documento llega con la lista exacta de campos.
        allow create: if documentoCorreo == documentoCorreo.lower()
          && request.resource.data.keys().hasOnly([
               'nombre', 'rol', 'activo',
               'creadoEn', 'creadoPor', 'creacionId',
               'ultimaConexion', 'sincronizacionId'
             ])
          && request.resource.data.keys().hasAll([
               'nombre', 'rol', 'activo', 'creadoEn', 'creadoPor', 'creacionId'
             ])
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() >= 1
          && request.resource.data.nombre.size() <= 60
          && request.resource.data.rol in ['admin', 'voluntario']
          && request.resource.data.activo is bool
          && horaDelServidor(request.resource.data.creadoEn)
          && request.resource.data.creadoPor == correo()
          && formatoId(request.resource.data.creacionId)
          && request.resource.data.get('ultimaConexion', null) == null
          && request.resource.data.get('sincronizacionId', null) == null
          && esAdmin(bib)
          && sinBloqueo(bib);

        // IMPORTANTE: el orden de estas dos ramas importa para el presupuesto
        // de accesos. Cada rama comprueba PRIMERO la forma de la escritura,
        // que es gratis, y solo entonces consulta otros documentos. Y la rama
        // de la muestra de hora va antes que la del administrador, porque es
        // la más frecuente y la más barata: así una sincronización gasta un
        // acceso, no los de la otra rama además.

        // Excepción del contrato §2: cada voluntario escribe EXACTAMENTE su
        // muestra de hora en su propio documento. No pasa por el bloqueo:
        // lectura y sincronización siguen disponibles en mantenimiento.
        allow update: if cambia(['ultimaConexion', 'sincronizacionId'])
          && documentoCorreo == correo()
          && horaDelServidor(request.resource.data.ultimaConexion)
          && formatoId(request.resource.data.sincronizacionId)
          && hayCorreoVerificado()
          && activo(docVoluntario(bib));

        // Un administrador cambia nombre, rol y estado. Los metadatos de
        // operación son parte de la lista permitida y no abren ningún otro
        // campo. `creacionId`, `creadoEn` y `creadoPor` son inmutables.
        allow update: if cambia(['nombre', 'rol', 'activo', 'ultimaOperacionId', 'modificadoEn'])
          && request.resource.data.keys().hasAll(['ultimaOperacionId', 'modificadoEn'])
          && formatoId(request.resource.data.ultimaOperacionId)
          && horaDelServidor(request.resource.data.modificadoEn)
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() >= 1
          && request.resource.data.nombre.size() <= 60
          && request.resource.data.rol in ['admin', 'voluntario']
          && request.resource.data.activo is bool
          // Un administrador no puede desactivarse ni quitarse el rol.
          && (documentoCorreo != correo()
              || (request.resource.data.activo == true
                  && request.resource.data.rol == 'admin'))
          && esAdmin(bib)
          && sinBloqueo(bib);

        // Nadie borra un voluntario.
        allow delete: if false;
      }

      // --- configuración ---------------------------------------------------

      match /config/app {
        allow read: if esVoluntario(bib);

        // Lo modifica solo un administrador, respetando tipos y largos.
        // `juegoCerradoAlgunaVez` es inmutable desde el cliente en esta etapa:
        // solo lo cambia la operación de cierre de la Etapa 5.
        allow update: if cambia([
               'nombreBiblioteca', 'plazoSabadosPorDefecto', 'categorias',
               'mensajeAtraso', 'mensajePrevio', 'inicioJuego',
               'ultimaOperacionId', 'modificadoEn'
             ])
          && request.resource.data.keys().hasAll(['ultimaOperacionId', 'modificadoEn'])
          && formatoId(request.resource.data.ultimaOperacionId)
          && horaDelServidor(request.resource.data.modificadoEn)
          && request.resource.data.nombreBiblioteca is string
          && request.resource.data.nombreBiblioteca.size() >= 1
          && request.resource.data.nombreBiblioteca.size() <= 40
          && request.resource.data.plazoSabadosPorDefecto is int
          && request.resource.data.plazoSabadosPorDefecto >= 1
          && request.resource.data.plazoSabadosPorDefecto <= 4
          && request.resource.data.categorias is list
          && request.resource.data.mensajeAtraso is string
          && request.resource.data.mensajeAtraso.size() >= 10
          && request.resource.data.mensajeAtraso.size() <= 400
          && request.resource.data.mensajePrevio is string
          && request.resource.data.mensajePrevio.size() >= 10
          && request.resource.data.mensajePrevio.size() <= 400
          && request.resource.data.inicioJuego is string
          && request.resource.data.inicioJuego.matches('^[0-9]{4}-[1-6]$')
          // Una vez que se cerró una temporada, `inicioJuego` no se mueve más
          // desde la app (contrato §8): cambiarlo escondería una fotografía ya
          // cerrada. El indicador solo lo levanta la operación de cierre.
          && (resource.data.get('juegoCerradoAlgunaVez', false) == false
              || request.resource.data.inicioJuego == resource.data.inicioJuego)
          && request.resource.data.juegoCerradoAlgunaVez == resource.data.juegoCerradoAlgunaVez
          && esAdmin(bib)
          && sinBloqueo(bib);

        // Lo crea y lo borra solo el script del dueño, que no pasa por reglas.
        allow create, delete: if false;
      }

      // Los contadores se leen siempre. Dos rendijas de escritura: `ultimoLector`
      // en el alta de un lector y `ultimoPrestamo` al crear un préstamo. Cada
      // una exige el enlace bidireccional del contrato §3 y no toca la otra.
      match /config/contadores {
        allow read: if esVoluntario(bib);

        allow update: if cambia(['ultimoLector', 'ultimoLectorId'])
          && request.resource.data.ultimoLector is int
          && request.resource.data.ultimoLector == resource.data.ultimoLector + 1
          && request.resource.data.ultimoLectorId == idDeLector(request.resource.data.ultimoLector)
          && esVoluntario(bib)
          && sinBloqueo(bib)
          && lectorRecienCreado(lectorDespues(bib, request.resource.data.ultimoLectorId));

        allow update: if cambia(['ultimoPrestamo', 'ultimoPrestamoId'])
          && request.resource.data.ultimoPrestamo is int
          && request.resource.data.ultimoPrestamo == resource.data.ultimoPrestamo + 1
          && request.resource.data.ultimoPrestamoId is string
          && formatoId(request.resource.data.ultimoPrestamoId)
          && esVoluntario(bib)
          && sinBloqueo(bib)
          && prestamoNuevoEnlazado(
               prestamoDespues(bib, request.resource.data.ultimoPrestamoId),
               request.resource.data.ultimoPrestamoId,
               request.resource.data.ultimoPrestamo
             );

        allow create, delete: if false;
      }

      // El control del bloqueo se lee para que la app sepa que está cerrada.
      // El mantenimiento lo pone y lo saca el script del dueño; el cierre llega
      // en la Etapa 5.
      match /config/control {
        allow read: if esVoluntario(bib);
        allow write: if false;
      }

      // Cualquier otro documento de config queda denegado por omisión: no hay
      // regla con comodín para esa colección.

      // --- libros ----------------------------------------------------------

      match /libros/{codigo} {

        // Los lee cualquier voluntario activo.
        allow read: if esVoluntario(bib);

        // Los crea solo un administrador. Un libro nace en el estante: sin
        // préstamo abierto, sin veces prestado y sin baja.
        allow create: if request.resource.data.keys().hasOnly([
               'codigo', 'titulo', 'autor', 'categoria', 'baja',
               'prestamoAbierto', 'vecesPrestado',
               'creadoEn', 'creadoPor', 'creacionId'
             ])
          && request.resource.data.keys().hasAll([
               'codigo', 'titulo', 'autor', 'categoria', 'baja',
               'prestamoAbierto', 'vecesPrestado',
               'creadoEn', 'creadoPor', 'creacionId'
             ])
          && request.resource.data.codigo == codigo
          && codigo.matches('^[A-Z]{2,4}[0-9]{3,4}[A-Z]?$')
          && tituloDeLibro(request.resource.data.titulo)
          && autorDeLibro(request.resource.data.autor)
          && categoriaDeLibro(request.resource.data.categoria)
          && request.resource.data.baja == false
          && request.resource.data.prestamoAbierto == null
          && request.resource.data.vecesPrestado is int
          && request.resource.data.vecesPrestado == 0
          && horaDelServidor(request.resource.data.creadoEn)
          && request.resource.data.creadoPor == correo()
          && formatoId(request.resource.data.creacionId)
          && esAdmin(bib)
          && sinBloqueo(bib);

        // Al editar, el administrador cambia solo estos cuatro campos. El
        // código es el identificador y no se renombra; `prestamoAbierto` y
        // `vecesPrestado` los mueven los préstamos, nunca una edición (C-07).
        allow update: if cambia(['titulo', 'autor', 'categoria', 'baja',
                                 'ultimaOperacionId', 'modificadoEn'])
          && request.resource.data.keys().hasAll(['ultimaOperacionId', 'modificadoEn'])
          && formatoId(request.resource.data.ultimaOperacionId)
          && horaDelServidor(request.resource.data.modificadoEn)
          && tituloDeLibro(request.resource.data.titulo)
          && autorDeLibro(request.resource.data.autor)
          && categoriaDeLibro(request.resource.data.categoria)
          && request.resource.data.baja is bool
          && esAdmin(bib)
          && sinBloqueo(bib);

        // Prestar: nulo → id, vecesPrestado +1; el préstamo nuevo debe
        // apuntar a este libro y el contador debe enlazarlo.
        allow update: if cambia(['prestamoAbierto', 'vecesPrestado'])
          && resource.data.prestamoAbierto == null
          && formatoId(request.resource.data.prestamoAbierto)
          && request.resource.data.vecesPrestado == resource.data.vecesPrestado + 1
          && resource.data.baja == false
          && esVoluntario(bib)
          && sinBloqueo(bib)
          && prestamoDespues(bib, request.resource.data.prestamoAbierto).data.libro == codigo
          && prestamoDespues(bib, request.resource.data.prestamoAbierto).data.creadoEn == request.time
          && prestamoDespues(bib, request.resource.data.prestamoAbierto).data.estado == 'abierto'
          && contadoresDespues(bib).data.ultimoPrestamoId == request.resource.data.prestamoAbierto
          && contadoresDespues(bib).data.ultimoPrestamo
               == prestamoDespues(bib, request.resource.data.prestamoAbierto).data.numero;

        // Devolver: libro libre, vecesPrestado igual. Anular: libre y −1.
        allow update: if cambia(['prestamoAbierto', 'vecesPrestado'])
          && resource.data.prestamoAbierto is string
          && request.resource.data.prestamoAbierto == null
          && esVoluntario(bib)
          && sinBloqueo(bib)
          && prestamoDespues(bib, resource.data.prestamoAbierto).data.libro == codigo
          && (
            (prestamoDespues(bib, resource.data.prestamoAbierto).data.estado == 'devuelto'
              && request.resource.data.vecesPrestado == resource.data.vecesPrestado)
            || (prestamoDespues(bib, resource.data.prestamoAbierto).data.estado == 'anulado'
              && request.resource.data.vecesPrestado == resource.data.vecesPrestado - 1
              && resource.data.vecesPrestado >= 1)
          );

        // Reabrir: libre → este préstamo; vecesPrestado no cambia.
        allow update: if cambia(['prestamoAbierto'])
          && resource.data.prestamoAbierto == null
          && formatoId(request.resource.data.prestamoAbierto)
          && request.resource.data.vecesPrestado == resource.data.vecesPrestado
          && esVoluntario(bib)
          && sinBloqueo(bib)
          && prestamoDespues(bib, request.resource.data.prestamoAbierto).data.estado == 'abierto'
          && prestamoDespues(bib, request.resource.data.prestamoAbierto).data.libro == codigo
          && prestamoDespues(bib, request.resource.data.prestamoAbierto).data.devueltoEn == null;

        allow delete: if false;
      }

      // --- lectores --------------------------------------------------------

      match /lectores/{idLector} {

        allow read: if esVoluntario(bib);

        // Alta de lector: la hace cualquier voluntario, y solo si en la MISMA
        // transacción queda creado su documento de clave y el contador sube
        // exactamente hasta el número de este identificador (C-21, C-38).
        //
        // El orden importa para el presupuesto: todas las comprobaciones de
        // forma, que son gratis, van antes de los cuatro accesos.
        allow create: if request.resource.data.keys().hasOnly([
               'nombre', 'clave', 'telefono', 'avisoDatos',
               'fusionadoEn', 'esDestinoFusion',
               'creadoEn', 'creadoPor', 'creacionId'
             ])
          && request.resource.data.keys().hasAll([
               'nombre', 'clave', 'telefono', 'avisoDatos',
               'fusionadoEn', 'esDestinoFusion',
               'creadoEn', 'creadoPor', 'creacionId'
             ])
          && formatoIdLector(idLector)
          && nombreDeLector(request.resource.data.nombre)
          && formatoClave(request.resource.data.clave)
          && telefonoDeLector(request.resource.data.telefono)
          && avisoDeDatos(request.resource.data.avisoDatos)
          && request.resource.data.fusionadoEn == null
          // Contrato §7: toda alta inicializa el campo en falso, para que la
          // unión de la Etapa 6 no se encuentre con lectores inservibles.
          && request.resource.data.esDestinoFusion == false
          && horaDelServidor(request.resource.data.creadoEn)
          && request.resource.data.creadoPor == correo()
          && formatoId(request.resource.data.creacionId)
          && esVoluntario(bib)
          && sinBloqueo(bib)
          && contadorEnlaza(contadoresDespues(bib), idLector)
          && claveApunta(claveDespues(bib, request.resource.data.clave), idLector);

        // El orden de estas dos ramas importa para el presupuesto: el cambio
        // de teléfono es el más frecuente y el más barato, y va primero.

        // Cualquier voluntario cambia el teléfono, y nada más (C-23).
        allow update: if cambia(['telefono', 'ultimaOperacionId', 'modificadoEn'])
          && request.resource.data.keys().hasAll(['ultimaOperacionId', 'modificadoEn'])
          && formatoId(request.resource.data.ultimaOperacionId)
          && horaDelServidor(request.resource.data.modificadoEn)
          && telefonoDeLector(request.resource.data.telefono)
          && esVoluntario(bib)
          && sinBloqueo(bib);

        // El administrador cambia además el nombre y su clave. La clave nueva
        // tiene que quedar apuntando a ESTE lector: si su documento ya existe
        // y apunta a otro, la escritura se deniega, que es el «Ya existe» del
        // servidor. Si la clave no cambia —corregir una tilde o una mayúscula,
        // C-37— no hace falta mirar ningún otro documento.
        allow update: if cambia(['nombre', 'clave', 'telefono',
                                 'ultimaOperacionId', 'modificadoEn'])
          && request.resource.data.keys().hasAll(['ultimaOperacionId', 'modificadoEn'])
          && formatoId(request.resource.data.ultimaOperacionId)
          && horaDelServidor(request.resource.data.modificadoEn)
          && nombreDeLector(request.resource.data.nombre)
          && formatoClave(request.resource.data.clave)
          && telefonoDeLector(request.resource.data.telefono)
          && esAdmin(bib)
          && sinBloqueo(bib)
          && (request.resource.data.clave == resource.data.clave
              || claveApunta(claveDespues(bib, request.resource.data.clave), idLector));

        // Un lector no se borra: en la Etapa 6 se une a otro (C-08).
        allow delete: if false;
      }

      // --- claves de nombre ------------------------------------------------

      match /lectoresClave/{clave} {

        allow read: if esVoluntario(bib);

        // Se crea solo si no existe —`create` no se aplica a un documento que
        // ya está— y solo si en la misma transacción queda un lector con esta
        // clave. Es la otra mitad del enlace del alta.
        allow create: if request.resource.data.keys().hasOnly([
               'lector', 'creadoEn', 'creadoPor', 'creacionId'
             ])
          && request.resource.data.keys().hasAll([
               'lector', 'creadoEn', 'creadoPor', 'creacionId'
             ])
          && formatoIdLector(request.resource.data.lector)
          && formatoClave(clave)
          && horaDelServidor(request.resource.data.creadoEn)
          && request.resource.data.creadoPor == correo()
          && formatoId(request.resource.data.creacionId)
          && esVoluntario(bib)
          && sinBloqueo(bib)
          && lectorTieneClave(lectorDespues(bib, request.resource.data.lector), clave);

        // Una clave existente no se redirige en esta etapa, ni siquiera por un
        // administrador (C-43). La unión de la Etapa 6 llegará con su propia
        // regla, que exigirá una unión válida hacia la raíz. Y una clave no se
        // borra: un nombre antiguo queda reservado (contrato §7).
        allow update, delete: if false;
      }

      // --- calendario de confianza -----------------------------------------

      match /calendario/{salidaDia} {
        allow read: if esVoluntario(bib);
        // Solo el script administrativo del dueño escribe aquí (contrato §4).
        allow create, update, delete: if false;
      }

      // --- préstamos -------------------------------------------------------

      match /prestamos/{idPrestamo} {

        allow read: if esVoluntario(bib);

        // Crear: forma + calendario + lector + libro apuntando aquí + contador.
        allow create: if formatoId(idPrestamo)
          && request.resource.data.keys().hasOnly([
               'numero', 'libro', 'lector',
               'prestadoEn', 'salidaDia', 'plazoSabados',
               'registroDiferido', 'motivoRegistroDiferido',
               'venceEl', 'temporada', 'estado',
               'devueltoEn', 'devueltoATiempo', 'correccionATiempo', 'devueltoPor',
               'anuladoEn', 'anuladoPor',
               'recordadoEn', 'recordadoPor',
               'creadoEn', 'creadoPor', 'creacionId', 'origen'
             ])
          && request.resource.data.numero is int
          && request.resource.data.libro.matches('^[A-Z]{2,4}[0-9]{3,4}[A-Z]?$')
          && formatoIdLector(request.resource.data.lector)
          && horaDelServidor(request.resource.data.prestadoEn)
          && horaDelServidor(request.resource.data.creadoEn)
          && request.resource.data.creadoPor == correo()
          && formatoId(request.resource.data.creacionId)
          && request.resource.data.salidaDia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.estado == 'abierto'
          && request.resource.data.origen == 'app'
          && request.resource.data.devueltoEn == null
          && request.resource.data.devueltoATiempo == null
          && request.resource.data.correccionATiempo == null
          && request.resource.data.devueltoPor == null
          && request.resource.data.anuladoEn == null
          && request.resource.data.anuladoPor == null
          && request.resource.data.recordadoEn == null
          && request.resource.data.recordadoPor == null
          && request.resource.data.registroDiferido is bool
          && (request.resource.data.registroDiferido == false || esAdmin(bib))
          && esVoluntario(bib)
          && sinBloqueo(bib)
          && calendarioCoincide(docCalendario(bib, request.resource.data.salidaDia), request.resource.data)
          && lectorPrestable(docLector(bib, request.resource.data.lector))
          && contadoresDespues(bib).data.ultimoPrestamo == request.resource.data.numero
          && contadoresDespues(bib).data.ultimoPrestamoId == idPrestamo
          && libroDespues(bib, request.resource.data.libro).data.prestamoAbierto == idPrestamo
          && libroDespues(bib, request.resource.data.libro).data.baja == false;

        // Devolver: abierto → devuelto; a tiempo nulo; libro libre.
        allow update: if cambia([
               'estado', 'devueltoEn', 'devueltoATiempo', 'correccionATiempo',
               'devueltoPor', 'ultimaOperacionId', 'modificadoEn'
             ])
          && metadatosDeOperacion()
          && resource.data.estado == 'abierto'
          && request.resource.data.estado == 'devuelto'
          && horaDelServidor(request.resource.data.devueltoEn)
          && request.resource.data.devueltoPor == correo()
          && request.resource.data.devueltoATiempo == null
          && request.resource.data.correccionATiempo == null
          && esVoluntario(bib)
          && sinBloqueo(bib)
          && libroDespues(bib, resource.data.libro).data.prestamoAbierto == null;

        // Reabrir: limpia devolución/corrección; libro apunta aquí.
        allow update: if cambia([
               'estado', 'devueltoEn', 'devueltoATiempo', 'correccionATiempo',
               'devueltoPor', 'ultimaOperacionId', 'modificadoEn'
             ])
          && metadatosDeOperacion()
          && resource.data.estado == 'devuelto'
          && request.resource.data.estado == 'abierto'
          && request.resource.data.devueltoEn == null
          && request.resource.data.devueltoATiempo == null
          && request.resource.data.correccionATiempo == null
          && request.resource.data.devueltoPor == null
          && (esAdmin(bib)
              || (resource.data.devueltoPor == correo()
                  && dentroDeDiezMinutos(resource.data.devueltoEn)))
          && esVoluntario(bib)
          && sinBloqueo(bib)
          && libroDespues(bib, resource.data.libro).data.prestamoAbierto == idPrestamo;

        // Anular: abierto → anulado; libro libre (veces −1 lo exige el libro).
        allow update: if cambia([
               'estado', 'anuladoEn', 'anuladoPor',
               'ultimaOperacionId', 'modificadoEn'
             ])
          && metadatosDeOperacion()
          && resource.data.estado == 'abierto'
          && request.resource.data.estado == 'anulado'
          && horaDelServidor(request.resource.data.anuladoEn)
          && request.resource.data.anuladoPor == correo()
          && (esAdmin(bib)
              || (resource.data.creadoPor == correo()
                  && dentroDeDiezMinutos(resource.data.prestadoEn)))
          && esVoluntario(bib)
          && sinBloqueo(bib)
          && libroDespues(bib, resource.data.libro).data.prestamoAbierto == null;

        // Corregir «a tiempo»: solo admin, solo en devuelto.
        allow update: if cambia([
               'devueltoATiempo', 'correccionATiempo',
               'ultimaOperacionId', 'modificadoEn'
             ])
          && metadatosDeOperacion()
          && resource.data.estado == 'devuelto'
          && request.resource.data.estado == 'devuelto'
          && request.resource.data.devueltoATiempo is bool
          && request.resource.data.correccionATiempo is map
          && request.resource.data.correccionATiempo.keys().hasOnly(['por', 'en', 'motivo'])
          && request.resource.data.correccionATiempo.keys().hasAll(['por', 'en', 'motivo'])
          && request.resource.data.correccionATiempo.por == correo()
          && horaDelServidor(request.resource.data.correccionATiempo.en)
          && request.resource.data.correccionATiempo.motivo is string
          && request.resource.data.correccionATiempo.motivo.size() >= 10
          && request.resource.data.correccionATiempo.motivo.size() <= 200
          && esAdmin(bib)
          && sinBloqueo(bib);

        // Recordar por WhatsApp: solo en abierto; solo recordadoEn/Por + meta.
        allow update: if cambia([
               'recordadoEn', 'recordadoPor',
               'ultimaOperacionId', 'modificadoEn'
             ])
          && metadatosDeOperacion()
          && resource.data.estado == 'abierto'
          && request.resource.data.estado == 'abierto'
          && horaDelServidor(request.resource.data.recordadoEn)
          && request.resource.data.recordadoPor == correo()
          && esVoluntario(bib)
          && sinBloqueo(bib);

        allow delete: if false;
      }
    }

    // Cualquier otra ruta: denegada.
  }
}
